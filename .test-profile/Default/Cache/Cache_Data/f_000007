      if (b['Arm_R']) b['Arm_R'].rotation.set(0.4, 0, 0.8 - chew * 0.1);
      if (b['Head']) b['Head'].rotation.set(0.35 + chew * 0.15, 0, 0);
      if (b['Tail_Ctrl']) b['Tail_Ctrl'].rotation.y = Math.sin(t * 14) * 0.6;
      return;
    }

    if (this.state === 'tumble') {
      // Tumble roll
      if (b['Arm_L']) b['Arm_L'].rotation.set(0, 0, -1.8);
      if (b['Arm_R']) b['Arm_R'].rotation.set(0, 0, 1.8);
      if (b['Head']) b['Head'].rotation.set(0.4, 0, 0.3);
