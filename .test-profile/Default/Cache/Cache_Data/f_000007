    }

    // Locomotion (Walk / Run / Zoomies / Idle)
    const isMoving = (this.state === 'walk' || this.state === 'run');
    const animSpeed = this.state === 'run' ? 14 : 7.5;
    const walkCycle = isMoving ? Math.sin(t * animSpeed) : 0;
    const cosCycle = isMoving ? Math.cos(t * animSpeed) : 0;
    const runIntensity = this.state === 'run' ? 1.5 : 1.0;

    // Arm swing
    if (b['Arm_L']) b['Arm_L'].rotation.set(0, 0, -1.2 + (isMoving ? walkCycle * 0.5 * runIntensity : Math.sin(t * 2) * 0.05));
    if (b['Arm_R']) b['Arm_R'].rotation.set(0, 0, 1.2 + (isMoving ? walkCycle * 0.5 * runIntensity : -Math.sin(t * 2) * 0.05));

    // Leg pendulum
    if (b['Thigh_L']) b['Thigh_L'].rotation.x = isMoving ? walkCycle * 0.65 * runIntensity : 0;
    if (b['Thigh_R']) b['Thigh_R'].rotation.x = isMoving ? -walkCycle * 0.65 * runIntensity : 0;
    if (b['Knee_L']) b['Knee_L'].rotation.x = isMoving ? Math.max(0, -walkCycle * 0.7 * runIntensity) : 0;
    if (b['Knee_R']) b['Knee_R'].rotation.x = isMoving ? Math.max(0, walkCycle * 0.7 * runIntensity) : 0;

    // Hip bounce & waddle
    if (b['Hip']) {
      if (isMoving) {
        b['Hip'].position.y = Math.abs(cosCycle) * 0.05 * runIntensity;
        b['Hip'].rotation.z = walkCycle * 0.1;
        b['Hip'].rotation.y = walkCycle * 0.08;
      } else {
        b['Hip'].position.y = Math.sin(t * 3) * 0.01;
        b['Hip'].rotation.set(0, 0, 0);
      }
    }

    // Head bob & look around
    if (b['Head']) {
