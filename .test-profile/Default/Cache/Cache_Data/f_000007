    const reactions = [
      'Poyo!! ✨',
      'H-Hey!!',
      'Hehehe stop that~',
      'You poked me!',
      this.getRandomQuote()
    ];
    this.say(reactions[Math.floor(Math.random() * reactions.length)], 2.2);

