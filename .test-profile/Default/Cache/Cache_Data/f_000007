  pet() {
    const now = performance.now();
    if (now - this.lastPetTime < 180) {
      this.petIntensity = Math.min(1.0, this.petIntensity + 0.25);
    } else {
      this.petIntensity = 0.2;
    }
    this.lastPetTime = now;

    ChibiAudio.playPurr();
    this.manager.particles.spawnHeart(this.screenX, this.screenY - 20);

    if (this.state !== 'dragged') {
      this.state = 'idle';
      this.stateTimer = 1.5;
    }

    if (Math.random() < 0.2) {
      const petQuotes = ['Ehehe~', 'So gentle~ ❤️', 'Headpats are the best!', 'Purrrrrr~'];
      this.say(petQuotes[Math.floor(Math.random() * petQuotes.length)], 2.0);
    }
  }

  startDrag(rayOrigin, rayDir) {
    this.isDragging = true;
    this.state = 'dragged';
    this.grounded = false;
    this.velocity.set(0, 0, 0);

    ChibiAudio.playSqueak(1.3);
    this.manager.particles.spawnEmote(this.screenX, this.screenY, '💦');
    this.say(['Waaah! Picked up!', 'Put me down please!', 'Dangling goober!'][Math.floor(Math.random() * 3)], 2.0);
  }

  updateDrag(worldTargetPos) {
    if (!this.isDragging) return;

    // Follow cursor with slight inertia
    const targetX = worldTargetPos.x;
    const targetY = Math.max(this.floorY + 0.2, worldTargetPos.y);

    const dx = targetX - this.position.x;
    const dy = targetY - this.position.y;

    this.dragVelocity.set(dx * 18, dy * 18);
    this.position.x += dx * 0.6;
    this.position.y += dy * 0.6;

    if (Math.abs(dx) > 0.05) {
      this.targetFacing = Math.sign(dx);
    }
  }

  endDrag() {
    if (!this.isDragging) return;
    this.isDragging = false;
    this.state = 'falling';

    // Fling physics from drag velocity
    this.velocity.x = Math.max(-10, Math.min(10, this.dragVelocity.x * 0.3));
    this.velocity.y = Math.max(-8, Math.min(10, this.dragVelocity.y * 0.3));

    if (Math.abs(this.velocity.x) > 4 || Math.abs(this.velocity.y) > 4) {
      this.say('Wheeeee!! 💨');
    }
  }

  feedSnack(snackPosition) {
    this.snackTarget = snackPosition;
    this.state = 'walk';
    this.walkTargetX = snackPosition.x;
    this.walkSpeed = 1.8;
    this.say('A SNACK?! 🥕✨', 2.5);
  }

  // Main Update Loop (called every frame)
  update(dt) {
    this.animTime += dt;
    this.stateTimer -= dt;
    this.bubbleTimer -= dt;

    if (this.bubbleTimer <= 0 && this.bubbleElement && this.bubbleElement.style.display !== 'none') {
      this.bubbleElement.style.display = 'none';
      this.bubbleElement.classList.remove('visible');
    }

    // AI Behavior decisions
    if (!this.isDragging && this.grounded) {
      this._updateAI(dt);
    }

    // Physics (Gravity, Movement, Boundaries, Bounce)
    this._updatePhysics(dt);

    // Procedural skeletal animations based on current state
    if (this.isLoaded) {
      this._updateSkeletalAnimation(dt);
    }

    // Update screen-projected positions for UI and particles
    this._updateScreenPosition();
  }

  _updateAI(dt) {
    if (this.stateTimer <= 0) {
      // Pick next activity
      const roll = Math.random();
      if (roll < 0.35) {
        // Walk somewhere along floor
        this.state = 'walk';
        const bounds = this.manager.getWorldBounds();
        this.walkTargetX = (Math.random() * (bounds.width - 2)) - (bounds.width / 2 - 1);
        this.walkSpeed = (0.7 + Math.random() * 0.6) * (this.config.speedMultiplier || 1.0) * this.manager.settings.speed;
        this.targetFacing = this.walkTargetX > this.position.x ? 1 : -1;
        this.stateTimer = 2.5 + Math.random() * 3.5;
      } else if (roll < 0.50) {
        // Zoomies / sprint!
        this.state = 'run';
        const bounds = this.manager.getWorldBounds();
        this.targetFacing = Math.random() > 0.5 ? 1 : -1;
        this.walkTargetX = this.targetFacing * (bounds.width / 2 - 0.5);
        this.walkSpeed = 2.4 * (this.config.speedMultiplier || 1.0) * this.manager.settings.speed;
        this.stateTimer = 2.0 + Math.random() * 2.0;
        if (Math.random() < 0.3) {
          this.say(['Zoomies!! 💨', 'So fast!!', 'Outta my way!'][Math.floor(Math.random() * 3)]);
        }
      } else if (roll < 0.85) {
        // Idle / look around
        this.state = 'idle';
        this.stateTimer = 2.0 + Math.random() * 4.0;
        if (Math.random() < 0.15) {
          this.targetFacing = -this.facingDirection;
        }
        if (Math.random() < 0.1) {
          this.say(this.getRandomQuote());
        }
      } else {
        // Take a quick power nap
        this.state = 'sleeping';
        this.stateTimer = 4.0 + Math.random() * 5.0;
        ChibiAudio.playYawn();
        this.say('Zzz... napping...', 2.0);
      }
    }

    // Check snack target
    if (this.snackTarget) {
      const dist = Math.abs(this.snackTarget.x - this.position.x);
      if (dist < 0.25) {
        this.snackTarget = null;
        this.state = 'eating';
        this.stateTimer = 3.0;
        ChibiAudio.playMunch();
        this.manager.particles.spawnCrumbs(this.screenX, this.screenY);
        this.say(['Mogu mogu! 🥕', 'So yummy!!', 'Delish! ✨'][Math.floor(Math.random() * 3)], 2.5);
      }
    }
  }

  _updatePhysics(dt) {
    const gravity = -18.0;
    const bounds = this.manager.getWorldBounds();

    if (!this.isDragging) {
      if (!this.grounded) {
        this.velocity.y += gravity * dt;
        this.position.x += this.velocity.x * dt;
        this.position.y += this.velocity.y * dt;

        // Check landing on floor
        if (this.position.y <= this.floorY) {
          this.position.y = this.floorY;
          const impactSpeed = Math.abs(this.velocity.y);
          this.grounded = true;

          // Squash & stretch on landing
          if (impactSpeed > 2.0) {
            const squashFactor = Math.min(0.5, impactSpeed * 0.05);
            this.squash.set(1 + squashFactor * 1.2, 1 - squashFactor, 1 + squashFactor * 1.2);
            ChibiAudio.playBoing(Math.min(1.0, impactSpeed * 0.15));

            if (impactSpeed > 8.0) {
              // High velocity tumble
              this.state = 'tumble';
              this.stateTimer = 1.2;
              this.manager.particles.spawnEmote(this.screenX, this.screenY, '💢');
            } else {
              this.state = 'idle';
              this.stateTimer = 1.0;
            }
          }

          this.velocity.set(0, 0, 0);
        }
      } else {
        // Ground movement logic
        if (this.state === 'walk' || this.state === 'run') {
          const dx = this.walkTargetX - this.position.x;
          if (Math.abs(dx) > 0.1) {
            const dir = Math.sign(dx);
            this.targetFacing = dir;
            this.position.x += dir * this.walkSpeed * dt;

            // Footstep audio
            this.stepTimer += dt * (this.state === 'run' ? 14 : 8);
            if (this.stepTimer >= 1.0) {
              this.stepTimer = 0;
              ChibiAudio.playStep(this.state === 'run' ? 0.3 : 0);
            }
          } else {
            this.state = 'idle';
            this.stateTimer = 1.5 + Math.random() * 2.0;
          }
        }
      }
    }

    // World floor boundaries
    const halfW = bounds.width / 2 - 0.4;
    if (this.position.x < -halfW) {
      this.position.x = -halfW;
      this.targetFacing = 1;
      this.velocity.x = Math.abs(this.velocity.x) * 0.5;
      if (this.state === 'walk' || this.state === 'run') {
        this.walkTargetX = Math.random() * halfW;
      }
    } else if (this.position.x > halfW) {
      this.position.x = halfW;
      this.targetFacing = -1;
      this.velocity.x = -Math.abs(this.velocity.x) * 0.5;
      if (this.state === 'walk' || this.state === 'run') {
        this.walkTargetX = -Math.random() * halfW;
      }
    }

    // Smooth facing turn
    this.facingDirection += (this.targetFacing - this.facingDirection) * 12 * dt;
    this.group.rotation.y = (this.facingDirection < 0 ? -Math.PI / 2 : Math.PI / 2);

    // Recover squash spring
    const springStrength = 180;
    const damping = 14;
    const fx = (1 - this.squash.x) * springStrength - this.squashVelocity.x * damping;
    const fy = (1 - this.squash.y) * springStrength - this.squashVelocity.y * damping;
    const fz = (1 - this.squash.z) * springStrength - this.squashVelocity.z * damping;
    this.squashVelocity.x += fx * dt;
    this.squashVelocity.y += fy * dt;
    this.squashVelocity.z += fz * dt;
    this.squash.x += this.squashVelocity.x * dt;
    this.squash.y += this.squashVelocity.y * dt;
    this.squash.z += this.squashVelocity.z * dt;

    const baseScale = (this.config.baseScale || 0.01) * this.manager.settings.scale;
    if (this.model) {
      this.model.scale.set(
        baseScale * this.squash.x,
        baseScale * this.squash.y,
        baseScale * this.squash.z
      );
    }
  }

  _updateSkeletalAnimation(dt) {
    const t = this.animTime;
    const b = this.bones;

    if (this.state === 'dragged') {
      // Dangling in air: frantic pedal kicks & flapping arms
      const kickFreq = 16;
      const kick = Math.sin(t * kickFreq);
      if (b['Arm_L']) b['Arm_L'].rotation.set(0, 0, -2.1 + kick * 0.4);
      if (b['Arm_R']) b['Arm_R'].rotation.set(0, 0, 2.1 + kick * 0.4);
      if (b['Thigh_L']) b['Thigh_L'].rotation.x = kick * 0.8;
      if (b['Thigh_R']) b['Thigh_R'].rotation.x = -kick * 0.8;
      if (b['Knee_L']) b['Knee_L'].rotation.x = Math.max(0, -kick * 1.0);
      if (b['Knee_R']) b['Knee_R'].rotation.x = Math.max(0, kick * 1.0);
      if (b['Head']) b['Head'].rotation.set(Math.sin(t * 8) * 0.2, 0, Math.cos(t * 8) * 0.2);
      if (b['Ear_01_L']) b['Ear_01_L'].rotation.z = Math.sin(t * 20) * 0.3;
      if (b['Ear_01_R']) b['Ear_01_R'].rotation.z = -Math.sin(t * 20) * 0.3;
      return;
    }

    if (this.state === 'falling') {
      // Falling panic pose
      if (b['Arm_L']) b['Arm_L'].rotation.set(0, 0, -2.4);
      if (b['Arm_R']) b['Arm_R'].rotation.set(0, 0, 2.4);
      if (b['Thigh_L']) b['Thigh_L'].rotation.x = 0.3;
      if (b['Thigh_R']) b['Thigh_R'].rotation.x = 0.3;
      if (b['Head']) b['Head'].rotation.set(-0.3, 0, 0);
      return;
    }

    if (this.state === 'sleeping') {
      // Sleeping: head drooped, slow rhythmic breathing
      const breathe = Math.sin(t * 2) * 0.03;
      if (b['Arm_L']) b['Arm_L'].rotation.set(0, 0, -0.6);
      if (b['Arm_R']) b['Arm_R'].rotation.set(0, 0, 0.6);
      if (b['Thigh_L']) b['Thigh_L'].rotation.x = 0;
      if (b['Thigh_R']) b['Thigh_R'].rotation.x = 0;
      if (b['Knee_L']) b['Knee_L'].rotation.x = 0;
      if (b['Knee_R']) b['Knee_R'].rotation.x = 0;
      if (b['Head']) b['Head'].rotation.set(0.35 + breathe, 0, 0.15);
      if (b['Ear_01_L']) b['Ear_01_L'].rotation.z = -0.3;
      if (b['Ear_01_R']) b['Ear_01_R'].rotation.z = 0.3;

      if (Math.random() < 0.015) {
        this.manager.particles.spawnSleepZzz(this.screenX, this.screenY);
      }
      return;
    }

    if (this.state === 'eating') {
