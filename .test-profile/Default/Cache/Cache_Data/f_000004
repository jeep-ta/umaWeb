export function resolveAssetUrl(path) {
  if (typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.getURL) {
    // Strip leading ./ if present
    const cleanPath = path.replace(/^\.\//, '');
    return chrome.runtime.getURL(cleanPath);
  }
  return path;
}

